!! -- Block ------------------------------------------------------------------

!!! Blok z ramkami i tytulem w jednym wywolaniu.
fun block_titled(title: Str) -> Block [
    let b = block_bordered()
    block_set_title(b, title)
    end b
]

fun block_with_title(b: Block, title: Str) -> Block [
    let o = b.clone()
    block_set_title(o, title)
    end o
]

fun block_with_title_bottom(b: Block, title: Str) -> Block [
    let o = b.clone()
    block_set_title_bottom(o, title)
    end o
]

fun block_with_title_align(b: Block, align: Int) -> Block [
    let o = b.clone()
    block_set_title_align(o, align)
    end o
]

fun block_with_borders(b: Block, borders: Int) -> Block [
    let o = b.clone()
    block_set_borders(o, borders)
    end o
]

fun block_with_border_type(b: Block, btype: Int) -> Block [
    let o = b.clone()
    block_set_border_type(o, btype)
    end o
]

fun block_with_style(b: Block, style: Style) -> Block [
    let o = b.clone()
    block_set_style(o, style)
    end o
]

fun block_with_border_style(b: Block, style: Style) -> Block [
    let o = b.clone()
    block_set_border_style(o, style)
    end o
]

fun block_with_padding(b: Block, left: Int, right: Int, top: Int, bottom: Int) -> Block [
    let o = b.clone()
    block_set_padding(o, left, right, top, bottom)
    end o
]

