fun chart_with_block(c: Chart, b: Block) -> Chart [
    let o = c.clone()
    chart_set_block(o, b)
    end o
]

fun chart_with_marker(c: Chart, m: Int) -> Chart [
    let o = c.clone()
    chart_set_marker(o, m)
    end o
]

fun chart_with_legend(c: Chart, on: Bool) -> Chart [
    let o = c.clone()
    chart_set_legend(o, on)
    end o
]

fun axis_with_title(a: Axis, title: Str) -> Axis [
    let o = a.clone()
    axis_set_title(o, title)
    end o
]

fun axis_with_labels(a: Axis, labels: List<Str>) -> Axis [
    let o = a.clone()
    axis_set_labels(o, labels)
    end o
]

fun calendar_with_block(c: Calendar, b: Block) -> Calendar [
    let o = c.clone()
    calendar_set_block(o, b)
    end o
]

fun calendar_with_selected(c: Calendar, day: Int) -> Calendar [
    let o = c.clone()
    calendar_set_selected(o, day)
    end o
]

fun calendar_with_today(c: Calendar, day: Int) -> Calendar [
    let o = c.clone()
    calendar_set_today(o, day)
    end o
]

fun calendar_with_event(c: Calendar, day: Int, style: Style) -> Calendar [
    let o = c.clone()
    calendar_add_event(o, day, style)
    end o
]

fun calendar_with_lang(c: Calendar, lang: Int) -> Calendar [
    let o = c.clone()
    calendar_set_lang(o, lang)
    end o
]
