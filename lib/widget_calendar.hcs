include <style>
include <geometry>
include <backend>
include <text>
include <buffer>
include <widget_block>

struct Calendar [
    year: Int,
    month: Int,
    selected: Int,
    today: Int,
    week_start: Int,
    lang: Int,
    event_days: List<Int>,
    event_styles: List<Style>,
    style: Style,
    header_style: Style,
    weekday_style: Style,
    selected_style: Style,
    today_style: Style,
    show_header: Bool,
    show_weekdays: Bool,
    block: Block,
    has_block: Bool
]

!!! Kalendarz miesiaca (`month` 1..12). Domyslnie tydzien od poniedzialku, jezyk polski.
fun calendar_new(year: Int, month: Int) -> Calendar [
    let ed: List<Int> = []
    let es: List<Style> = []
    end Calendar(year, month, 0, 0, 1, 0, ed, es, style_new(), style_of(COLOR_YELLOW, 0, 1), style_of(COLOR_CYAN, 0, 0), style_of(COLOR_BLACK, COLOR_WHITE, 0), style_of(0, 0, 8), true, true, block_new(), false)
]

fun calendar_set_selected(c: Calendar, day: Int) [
    c.selected = day
    end
]

fun calendar_set_today(c: Calendar, day: Int) [
    c.today = day
    end
]

!!! `week_start`: 1 = poniedzialek, 0 = niedziela.
fun calendar_set_week_start(c: Calendar, week_start: Int) [
    c.week_start = week_start
    end
]

!!! `lang`: 0 = polski, 1 = angielski.
fun calendar_set_lang(c: Calendar, lang: Int) [
    c.lang = lang
    end
]

fun calendar_set_block(c: Calendar, b: Block) [
    c.block = b.clone()
    c.has_block = true
    end
]

fun calendar_add_event(c: Calendar, day: Int, style: Style) [
    c.event_days.push(day)
    c.event_styles.push(style.clone())
    end
]

fun calendar_set_selected_style(c: Calendar, s: Style) [
    c.selected_style = s.clone()
    end
]

fun is_leap_year(y: Int) -> Bool [
    end (y % 4 == 0 and y % 100 != 0) or y % 400 == 0
]

fun days_in_month(y: Int, m: Int) -> Int [
    if m == 2 [
        if is_leap_year(y) [
            end 29
        ]
        end 28
    ]
    if m == 4 or m == 6 or m == 9 or m == 11 [
        end 30
    ]
    end 31
]

!!! Dzien tygodnia: 0 = niedziela ... 6 = sobota (algorytm Sakamoto).
fun weekday_of(y: Int, m: Int, d: Int) -> Int [
    let t = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]
    let yy = y
    if m < 3 [
        yy = yy - 1
    ]
    end (yy + yy / 4 - yy / 100 + yy / 400 + t[m - 1] + d) % 7
]

fun month_name(m: Int, lang: Int) -> Str [
    let pl = ["Styczeń", "Luty", "Marzec", "Kwiecień", "Maj", "Czerwiec", "Lipiec", "Sierpień", "Wrzesień", "Październik", "Listopad", "Grudzień"]
    let en = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
    if lang == 1 [
        end en[m - 1].clone()
    ]
    end pl[m - 1].clone()
]

fun calendar_event_style(c: Calendar, day: Int) -> Style [
    let i = 0
    while i < c.event_days.len() [
        if c.event_days[i] == day [
            end c.event_styles[i].clone()
        ]
        i = i + 1
    ]
    end style_new()
]

fun calendar_has_event(c: Calendar, day: Int) -> Bool [
    let i = 0
    while i < c.event_days.len() [
        if c.event_days[i] == day [
            end true
        ]
        i = i + 1
    ]
    end false
]

!!! Przesuwa miesiac o `delta` (np. +1 / -1) z przeniesieniem roku.
fun calendar_shift_month(c: Calendar, delta: Int) [
    let total = c.year * 12 + (c.month - 1) + delta
    c.year = total / 12
    c.month = total % 12 + 1
    if c.selected > days_in_month(c.year, c.month) [
        c.selected = days_in_month(c.year, c.month)
    ]
    end
]

fun render_calendar(buf: Buffer, c: Calendar, area: Rect) [
    let inner = area.clone()
    if c.has_block [
        render_block(buf, c.block, area)
        inner = block_inner(c.block, area)
    ]
    buffer_set_style(buf, inner, c.style)
    if inner.width < 20 or inner.height < 1 [
        end
    ]
    let x0 = inner.x + (inner.width - 20) / 2
    let y = inner.y
    if c.show_header [
        let title = month_name(c.month, c.lang) + " " + (c.year as Str)
        let tw = uni_width(title.clone())
        buffer_set_string(buf, inner.x + (inner.width - tw) / 2, y, title.clone(), c.header_style, tw)
        y = y + 1
    ]
    let pl = ["Pn", "Wt", "Śr", "Cz", "Pt", "So", "Nd"]
    let en = ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"]
    if c.show_weekdays [
        let k = 0
        while k < 7 [
            let idx = (k + (c.week_start + 6) % 7) % 7
            let nm = pl[idx].clone()
            if c.lang == 1 [
                nm = en[idx].clone()
            ]
            buffer_set_string(buf, x0 + k * 3, y, nm, c.weekday_style, 2)
            k = k + 1
        ]
        y = y + 1
    ]
    let first = weekday_of(c.year, c.month, 1)
    let offset = (first - c.week_start + 7) % 7
    let dim = days_in_month(c.year, c.month)
    let d = 1
    while d <= dim [
        let pos = offset + d - 1
        let row = pos / 7
        let col = pos % 7
        let yy = y + row
        if yy < inner.y + inner.height [
            let st = calendar_event_style(c, d)
            if d == c.today [
                st = style_patch(st, c.today_style)
            ]
            if d == c.selected [
                st = style_patch(st, c.selected_style)
            ]
            let txt = d as Str
            if d < 10 [
                txt = " " + txt
            ]
            buffer_set_string(buf, x0 + col * 3, yy, txt, st, 2)
        ]
        d = d + 1
    ]
    end
]

!!! Wysokosc kalendarza (naglowki + tygodnie) - do layoutu.
fun calendar_height(c: Calendar) -> Int [
    let first = weekday_of(c.year, c.month, 1)
    let offset = (first - c.week_start + 7) % 7
    let weeks = (offset + days_in_month(c.year, c.month) + 6) / 7
    let h = weeks
    if c.show_header [
        h = h + 1
    ]
    if c.show_weekdays [
        h = h + 1
    ]
    end h
]
