    static MOLD_WIDE: &[(u32, u32)] = &[(0x1100, 0x115F), (0x231A, 0x231B), (0x2329, 0x232A), (0x23E9, 0x23EC), (0x23F0, 0x23F0), (0x23F3, 0x23F3), (0x25FD, 0x25FE), (0x2614, 0x2615), (0x2648, 0x2653), (0x267F, 0x267F), (0x2693, 0x2693), (0x26A1, 0x26A1), (0x26AA, 0x26AB), (0x26BD, 0x26BE), (0x26C4, 0x26C5), (0x26CE, 0x26CE), (0x26D4, 0x26D4), (0x26EA, 0x26EA), (0x26F2, 0x26F3), (0x26F5, 0x26F5), (0x26FA, 0x26FA), (0x26FD, 0x26FD), (0x2705, 0x2705), (0x270A, 0x270B), (0x2728, 0x2728), (0x274C, 0x274C), (0x274E, 0x274E), (0x2753, 0x2755), (0x2757, 0x2757), (0x2795, 0x2797), (0x27B0, 0x27B0), (0x27BF, 0x27BF), (0x2B1B, 0x2B1C), (0x2B50, 0x2B50), (0x2B55, 0x2B55), (0x2E80, 0x2E99), (0x2E9B, 0x2EF3), (0x2F00, 0x2FD5), (0x2FF0, 0x2FFB), (0x3000, 0x303E), (0x3041, 0x3096), (0x3099, 0x30FF), (0x3105, 0x312F), (0x3131, 0x318E), (0x3190, 0x31E3), (0x31F0, 0x321E), (0x3220, 0x3247), (0x3250, 0x4DBF), (0x4E00, 0xA48C), (0xA490, 0xA4C6), (0xA960, 0xA97C), (0xAC00, 0xD7A3), (0xF900, 0xFAFF), (0xFE10, 0xFE19), (0xFE30, 0xFE52), (0xFE54, 0xFE66), (0xFE68, 0xFE6B), (0xFF01, 0xFF60), (0xFFE0, 0xFFE6), (0x16FE0, 0x16FE4), (0x16FF0, 0x16FF1), (0x17000, 0x187F7), (0x18800, 0x18CD5), (0x18D00, 0x18D08), (0x1AFF0, 0x1AFF3), (0x1AFF5, 0x1AFFB), (0x1AFFD, 0x1AFFE), (0x1B000, 0x1B122), (0x1B132, 0x1B132), (0x1B150, 0x1B152), (0x1B155, 0x1B155), (0x1B164, 0x1B167), (0x1B170, 0x1B2FB), (0x1F004, 0x1F004), (0x1F0CF, 0x1F0CF), (0x1F18E, 0x1F18E), (0x1F191, 0x1F19A), (0x1F200, 0x1F202), (0x1F210, 0x1F23B), (0x1F240, 0x1F248), (0x1F250, 0x1F251), (0x1F260, 0x1F265), (0x1F300, 0x1F320), (0x1F32D, 0x1F335), (0x1F337, 0x1F37C), (0x1F37E, 0x1F393), (0x1F3A0, 0x1F3CA), (0x1F3CF, 0x1F3D3), (0x1F3E0, 0x1F3F0), (0x1F3F4, 0x1F3F4), (0x1F3F8, 0x1F43E), (0x1F440, 0x1F440), (0x1F442, 0x1F4FC), (0x1F4FF, 0x1F53D), (0x1F54B, 0x1F54E), (0x1F550, 0x1F567), (0x1F57A, 0x1F57A), (0x1F595, 0x1F596), (0x1F5A4, 0x1F5A4), (0x1F5FB, 0x1F64F), (0x1F680, 0x1F6C5), (0x1F6CC, 0x1F6CC), (0x1F6D0, 0x1F6D2), (0x1F6D5, 0x1F6D7), (0x1F6DC, 0x1F6DF), (0x1F6EB, 0x1F6EC), (0x1F6F4, 0x1F6FC), (0x1F7E0, 0x1F7EB), (0x1F7F0, 0x1F7F0), (0x1F90C, 0x1F93A), (0x1F93C, 0x1F945), (0x1F947, 0x1F9FF), (0x1FA70, 0x1FA7C), (0x1FA80, 0x1FA88), (0x1FA90, 0x1FABD), (0x1FABF, 0x1FAC5), (0x1FACE, 0x1FADB), (0x1FAE0, 0x1FAE8), (0x1FAF0, 0x1FAF8), (0x20000, 0x2FFFD), (0x30000, 0x3FFFD)];

    fn mold_in(table: &[(u32, u32)], u: u32) -> bool {
        let mut lo = 0usize;
        let mut hi = table.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            let (a, b) = table[mid];
            if u < a {
                hi = mid;
            } else if u > b {
                lo = mid + 1;
            } else {
                return true;
            }
        }
        false
    }

    pub fn mold_char_width(c: char) -> usize {
        let u = c as u32;
        if u < 32 || (u >= 0x7f && u < 0xa0) {
            return 0;
        }
        if u < 0x300 {
            return 1;
        }
        if mold_in(MOLD_ZERO, u) {
            return 0;
        }
        if mold_in(MOLD_WIDE, u) {
            return 2;
        }
        1
    }

    pub fn mold_clusters(s: &str) -> Vec<(String, usize)> {
        let mut out: Vec<(String, usize)> = Vec::new();
        let mut join_next = false;
        let mut ri_open = false;
        for c in s.chars() {
            let u = c as u32;
            let w = mold_char_width(c);
            let is_mod = u >= 0x1f3fb && u <= 0x1f3ff;
            let is_ri = u >= 0x1f1e6 && u <= 0x1f1ff;
            if !out.is_empty() {
                let last = out.len() - 1;
                if join_next {
                    out[last].0.push(c);
                    if w > out[last].1 {
                        out[last].1 = w;
                    }
                    join_next = u == 0x200d;
                    continue;
                }
                if w == 0 || is_mod {
                    out[last].0.push(c);
                    if u == 0xfe0f {
                        out[last].1 = 2;
                    }
                    join_next = u == 0x200d;
                    continue;
                }
                if is_ri && ri_open {
                    out[last].0.push(c);
                    out[last].1 = 2;
                    ri_open = false;
                    continue;
                }
            }
            if w == 0 {
                continue;
            }
            ri_open = is_ri;
            join_next = false;
            out.push((c.to_string(), w));
        }
        out
    }

    pub fn mold_cut(s: &str, start: i64, width: i64) -> String {
        let mut out = String::new();
        if width <= 0 {
            return out;
        }
        let mut col: i64 = 0;
        let end = start + width;
        for (g, w) in mold_clusters(s) {
            let w = w as i64;
            let g_start = col;
            let g_end = col + w;
            col = g_end;
            if g_end <= start {
                continue;
            }
            if g_start >= end {
                break;
            }
            if g_start < start || g_end > end {
                let visible = g_end.min(end) - g_start.max(start);
                for _ in 0..visible {
                    out.push(' ');
                }
            } else {
                out.push_str(&g);
            }
        }
        out
    }

    pub fn mold_wrap(s: &str, width: i64, trim: bool) -> Vec<String> {
        let width = if width < 1 { 1 } else { width };
        let mut lines: Vec<String> = Vec::new();
        for raw in s.split('\n') {
            let mut cur = String::new();
            let mut cur_w: i64 = 0;
            let mut tokens: Vec<(String, i64, String, i64)> = Vec::new();
            let mut space = String::new();
            let mut space_w: i64 = 0;
            let mut word = String::new();
            let mut word_w: i64 = 0;
            for (g, w) in mold_clusters(raw) {
                if g == " " || g == "\t" {
                    if word_w > 0 {
                        tokens.push((std::mem::take(&mut space), space_w, std::mem::take(&mut word), word_w));
                        space_w = 0;
                        word_w = 0;
                    }
                    space.push(' ');
                    space_w += 1;
                } else {
                    word.push_str(&g);
                    word_w += w as i64;
                }
            }
            if word_w > 0 {
                tokens.push((space, space_w, word, word_w));
            }
            let mut first = true;
            for (sp, sp_w, wd, wd_w) in tokens {
                let (sep, sep_w) = if trim {
                    if cur_w > 0 { (" ".to_string(), 1) } else { (String::new(), 0) }
                } else {
                    (sp, sp_w)
                };
                if wd_w > width {
                    if cur_w > 0 {
                        lines.push(std::mem::take(&mut cur));
                        cur_w = 0;
                    }
                    let mut piece = String::new();
                    let mut piece_w: i64 = 0;
                    for (g, w) in mold_clusters(&wd) {
                        let w = w as i64;
                        if piece_w + w > width {
                            lines.push(std::mem::take(&mut piece));
                            piece_w = 0;
                        }
                        piece.push_str(&g);
                        piece_w += w;
                    }
                    cur = piece;
                    cur_w = piece_w;
                } else if cur_w + sep_w + wd_w <= width {
                    cur.push_str(&sep);
                    cur.push_str(&wd);
                    cur_w += sep_w + wd_w;
                } else {
                    lines.push(std::mem::take(&mut cur));
                    cur = wd;
                    cur_w = wd_w;
                }
                first = false;
            }
            let _ = first;
            lines.push(cur);
        }
        lines
    }

    type MoldEv = (String, String, i64, i64, i64);

    fn mold_key(code: &str, mods: i64) -> MoldEv {
        ("key".to_string(), code.to_string(), mods, 0, 0)
    }

    fn mold_csi(params: &str, f: u8) -> MoldEv {
        if params.starts_with('<') && (f == b'M' || f == b'm') {
            let nums: Vec<i64> = params[1..].split(';').map(|p| p.parse::<i64>().unwrap_or(0)).collect();
            if nums.len() >= 3 {
                let b = nums[0];
                let x = nums[1] - 1;
                let y = nums[2] - 1;
                let mods = (if b & 4 != 0 { 1 } else { 0 }) | (if b & 8 != 0 { 4 } else { 0 }) | (if b & 16 != 0 { 2 } else { 0 });
                if b & 64 != 0 {
                    let code = match b & 3 {
                        0 => "ScrollUp",
                        1 => "ScrollDown",
                        2 => "ScrollLeft",
                        _ => "ScrollRight",
                    };
                    return ("mouse_scroll".to_string(), code.to_string(), mods, x, y);
                }
                let button = match b & 3 {
                    0 => "Left",
                    1 => "Middle",
                    2 => "Right",
                    _ => "None",
                };
                let kind = if b & 32 != 0 {
                    if button == "None" { "mouse_move" } else { "mouse_drag" }
                } else if f == b'M' {
                    "mouse_down"
                } else {
                    "mouse_up"
                };
                return (kind.to_string(), button.to_string(), mods, x, y);
            }
            return mold_key("Unknown", 0);
        }
        let parts: Vec<i64> = params.split(';').map(|p| p.parse::<i64>().unwrap_or(0)).collect();
        let m = if parts.len() >= 2 { parts[1] - 1 } else { 0 };
        let mods = (if m & 1 != 0 { 1 } else { 0 }) | (if m & 2 != 0 { 4 } else { 0 }) | (if m & 4 != 0 { 2 } else { 0 });
        let first = if parts.is_empty() { 0 } else { parts[0] };
        let code: &str = match f {
            b'A' => "Up",
            b'B' => "Down",
            b'C' => "Right",
            b'D' => "Left",
            b'H' => "Home",
            b'F' => "End",
            b'P' => "F1",
            b'Q' => "F2",
            b'R' => "F3",
            b'S' => "F4",
            b'Z' => return mold_key("BackTab", 1),
            b'~' => match first {
                1 | 7 => "Home",
                2 => "Insert",
                3 => "Delete",
                4 | 8 => "End",
                5 => "PageUp",
                6 => "PageDown",
                11 => "F1",
                12 => "F2",
                13 => "F3",
                14 => "F4",
                15 => "F5",
                17 => "F6",
                18 => "F7",
                19 => "F8",
                20 => "F9",
                21 => "F10",
                23 => "F11",
                24 => "F12",
                _ => "Unknown",
            },
            _ => "Unknown",
        };
        mold_key(code, mods)
    }

    fn mold_parse_event(buf: &mut Vec<u8>) -> Option<MoldEv> {
        if buf.is_empty() {
            return None;
        }
        let b0 = buf[0];
        if b0 == 0x1b {
            if buf.len() == 1 {
                return None;
            }
            let b1 = buf[1];
            if b1 == 0x5b {
                let mut i = 2;
                while i < buf.len() && !(buf[i] >= 0x40 && buf[i] <= 0x7e) {
                    i += 1;
                }
                if i >= buf.len() {
                    return None;
                }
                let f = buf[i];
                let params = String::from_utf8_lossy(&buf[2..i]).to_string();
                buf.drain(0..=i);
                return Some(mold_csi(&params, f));
            }
            if b1 == b'O' {
                if buf.len() < 3 {
                    return None;
                }
                let c = buf[2];
                buf.drain(0..3);
                return Some(mold_csi("", c));
            }
            if b1 == 0x1b {
                buf.remove(0);
                return Some(mold_key("Esc", 0));
            }
            buf.remove(0);
            match mold_parse_event(buf) {
                Some(mut ev) => {
                    ev.2 |= 4;
                    return Some(ev);
                }
                None => {
                    buf.insert(0, 0x1b);
                    return None;
                }
            }
        }
        if b0 == 0x0d || b0 == 0x0a {
            buf.remove(0);
            return Some(mold_key("Enter", 0));
        }
        if b0 == 0x09 {
            buf.remove(0);
            return Some(mold_key("Tab", 0));
        }
        if b0 == 0x08 || b0 == 0x7f {
            buf.remove(0);
            return Some(mold_key("Backspace", 0));
        }
        if b0 == 0x00 {
            buf.remove(0);
            return Some(mold_key(" ", 2));
        }
        if b0 >= 0x01 && b0 <= 0x1a {
            buf.remove(0);
            let c = ((b0 + 96) as char).to_string();
            return Some(mold_key(&c, 2));
        }
        if b0 >= 0x1c && b0 <= 0x1f {
            buf.remove(0);
            let c = match b0 {
                0x1c => "\\",
                0x1d => "\x5d",
                0x1e => "^",
                _ => "_",
            };
            return Some(mold_key(c, 2));
        }
        if b0 < 0x80 {
            buf.remove(0);
            return Some(mold_key(&(b0 as char).to_string(), 0));
        }
        let need = if b0 >= 0xf0 { 4 } else if b0 >= 0xe0 { 3 } else if b0 >= 0xc0 { 2 } else { 1 };
        if need == 1 {
            buf.remove(0);
            return Some(mold_key("Unknown", 0));
        }
        if buf.len() < need {
            return None;
        }
        let chunk: Vec<u8> = buf.drain(0..need).collect();
        match String::from_utf8(chunk) {
            Ok(s) => Some(mold_key(&s, 0)),
            Err(_) => Some(mold_key("Unknown", 0)),
        }
    }

    pub fn mold_next_event(timeout_ms: i64) -> MoldEv {
        let deadline = std::time::Instant::now() + std::time::Duration::from_millis(if timeout_ms < 0 { 0 } else { timeout_ms as u64 });
        loop {
            let has_pending;
            {
                let mut p = match MOLD_PENDING.lock() {
                    Ok(g) => g,
                    Err(e) => e.into_inner(),
                };
                if !p.is_empty() {
                    if let Some(ev) = mold_parse_event(&mut p) {
                        return ev;
                    }
                }
                has_pending = !p.is_empty();
            }
            let now = std::time::Instant::now();
            let left_ms: i64 = if deadline > now { deadline.duration_since(now).as_millis() as i64 } else { 0 };
            let wait: i32 = if has_pending { 25 } else if left_ms > 50 { 50 } else { left_ms as i32 };
            let mut pfd = MoldPollFd { fd: 0, events: 1, revents: 0 };
            let r = unsafe { poll(&mut pfd as *mut MoldPollFd, 1, wait) };
            if r > 0 {
                let mut tmp = [0u8; 512];
                let n = unsafe { read(0, tmp.as_mut_ptr(), 512) };
                if n > 0 {
                    let mut p = match MOLD_PENDING.lock() {
                        Ok(g) => g,
                        Err(e) => e.into_inner(),
                    };
                    p.extend_from_slice(&tmp[..n as usize]);
                    continue;
                }
                if n == 0 {
                    return ("eof".to_string(), String::new(), 0, 0, 0);
                }
                continue;
            }
            if has_pending {
                let mut p = match MOLD_PENDING.lock() {
                    Ok(g) => g,
                    Err(e) => e.into_inner(),
                };
                if p.first() == Some(&0x1b) {
                    p.remove(0);
                    return mold_key("Esc", 0);
                }
                p.clear();
                continue;
            }
            let (w, h) = mold_size();
            {
                let mut last = match MOLD_LAST_SIZE.lock() {
                    Ok(g) => g,
                    Err(e) => e.into_inner(),
                };
                if last.0 == 0 {
                    *last = (w, h);
                } else if *last != (w, h) {
                    *last = (w, h);
                    return ("resize".to_string(), String::new(), 0, w, h);
                }
            }
            if std::time::Instant::now() >= deadline {
                return ("none".to_string(), String::new(), 0, 0, 0);
            }
        }
    }

    pub fn mold_note_size(w: i64, h: i64) {
        let mut last = match MOLD_LAST_SIZE.lock() {
            Ok(g) => g,
            Err(e) => e.into_inner(),
        };
        *last = (w, h);
    }
]

!! -- typy -------------------------------------------------------------------

!!! Rozmiar terminala w komorkach.
struct Size [
    width: Int,
    height: Int
]

!!! Zdarzenie wejscia. `kind`: "none" (timeout), "key", "resize" (x=szer, y=wys),
!!! "mouse_down" | "mouse_up" | "mouse_drag" | "mouse_move" | "mouse_scroll",
!!! "eof" (stdin zamkniety). Dla "key": `code` to znak ("a", "ż", " ") albo nazwa
!!! ("Enter", "Esc", "Tab", "BackTab", "Backspace", "Up", "Down", "Left", "Right",
!!! "Home", "End", "PageUp", "PageDown", "Insert", "Delete", "F1".."F12").
!!! Dla myszy: `code` to przycisk ("Left"/"Middle"/"Right"/"None") albo kierunek
!!! ("ScrollUp"/"ScrollDown"/"ScrollLeft"/"ScrollRight"), `x`/`y` to komorka (od 0).
!!! `mods`: suma flag MOD_SHIFT(1) + MOD_CTRL(2) + MOD_ALT(4).
struct Event [
    kind: Str,
    code: Str,
    mods: Int,
    x: Int,
    y: Int
]

const KEY_SHIFT: Int = 1
const KEY_CTRL: Int = 2
const KEY_ALT: Int = 4

!! -- terminal ---------------------------------------------------------------

!!! Wlacza tryb raw (bez echa, bez buforowania linii, bez ISIG - Ctrl+C przychodzi
!!! jako zdarzenie klawisza) i instaluje panic-hook przywracajacy terminal.
!!! `false` gdy stdin nie jest terminalem.
fun backend_raw_enable() -> Bool [
    let ok = false
    native {Rust} [
        ok = mold_raw_enable();
    ]
    end ok
]

!!! Przywraca ustawienia terminala sprzed `backend_raw_enable()`.
fun backend_raw_disable() [
    native {Rust} [
        mold_raw_restore();
    ]
    end
]

!!! Aktualny rozmiar terminala (80x24 gdy nieznany).
fun backend_size() -> Size [
    let w = 80
    let h = 24
    native {Rust} [
        let sz = mold_size();
        w = sz.0;
        h = sz.1;
        mold_note_size(w, h);
    ]
    end Size(w, h)
]

!!! Zapisuje `s` na stdout i splukuje bufor (jedno `write` na klatke).
fun backend_write(s: Str) [
    native {Rust} [
        use std::io::Write;
        let out = std::io::stdout();
        let mut lock = out.lock();
        let _ = lock.write_all(s.as_bytes());
        let _ = lock.flush();
    ]
    end
]

!!! Czeka najdluzej `timeout_ms` na zdarzenie. Przy `kind == "none"` minal timeout.
!!! Zmiana rozmiaru okna jest wykrywana tu (zdarzenie "resize").
fun backend_poll(timeout_ms: Int) -> Event [
    let kind = ""
    let code = ""
    let mods = 0
    let ex = 0
    let ey = 0
    native {Rust} [
        let ev = mold_next_event(timeout_ms);
        kind = ev.0;
        code = ev.1;
        mods = ev.2;
        ex = ev.3;
        ey = ev.4;
    ]
    end Event(kind, code, mods, ex, ey)
]

!! -- Unicode ----------------------------------------------------------------

!!! Szerokosc `s` w komorkach terminala (CJK/emoji = 2, znaki laczace = 0).
fun uni_width(s: Str) -> Int [
    let w = 0
    native {Rust} [
        w = mold_clusters(s).iter().map(|c| c.1 as i64).sum::<i64>();
    ]
    end w
]

!!! Szerokosc pojedynczego znaku (0, 1 lub 2).
fun uni_char_width(c: Str) -> Int [
    let w = 0
    native {Rust} [
        w = c.chars().next().map(|ch| mold_char_width(ch) as i64).unwrap_or(0);
    ]
    end w
]

!!! Dzieli `s` na klastry (znak + znaki laczace) - jednostki jednej komorki/dwoch.
fun uni_graphemes(s: Str) -> List<Str> [
    let out: List<Str> = []
    native {Rust} [
        out = mold_clusters(s).into_iter().map(|c| c.0).collect();
    ]
    end out
]

!!! Wycinek `s` o szerokosci `width` komorek, od kolumny `start` (znak przecinany
!!! na granicy zastepowany spacja).
fun uni_cut(s: Str, start: Int, width: Int) -> Str [
    let out = ""
    native {Rust} [
        out = mold_cut(s, start, width);
    ]
    end out
]

!!! Zawijanie wierszy do `width` komorek. `trim = true` obcina biale znaki na
!!! poczatku zawinietych wierszy. Zachowuje puste wiersze (`\n`).
fun uni_wrap(s: Str, width: Int, trim: Bool) -> List<Str> [
    let out: List<Str> = []
    native {Rust} [
        out = mold_wrap(s, width, trim);
    ]
    end out
]

!!! Dzieli `s` na wiersze po `\n` (zawsze co najmniej jeden element).
fun uni_lines(s: Str) -> List<Str> [
    let out: List<Str> = []
    native {Rust} [
        out = s.split('\n').map(|l| l.to_string()).collect();
    ]
    end out
]

!!! Znak Braille'a U+2800 + n (n = 0..255, suma bitow kropek).
fun uni_braille(n: Int) -> Str [
    let out = " "
    native {Rust} [
        out = char::from_u32(0x2800 + (n as u32 & 0xff)).unwrap_or(' ').to_string();
    ]
    end out
]

!!! Liczba do tekstu: calkowite bez czesci dziesietnej, inne z `decimals` miejscami
!!! (bez konczacych zer), np. 3.0 -> "3", 2.50 -> "2.5".
fun fmt_num(f: Float, decimals: Int) -> Str [
    let out = ""
    native {Rust} [
        let d = if decimals < 0 { 0 } else { decimals as usize };
        let mut s = format!("{:.*}", d, f);
        if s.contains('.') {
            while s.ends_with('0') {
                s.pop();
            }
            if s.ends_with('.') {
                s.pop();
            }
        }
        if s == "-0" {
            s = "0".to_string();
        }
        out = s;
    ]
    end out
]
