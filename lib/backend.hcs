native {Rust} [
    #[repr(C)]
    #[derive(Clone, Copy)]
    pub struct MoldTermios {
        c_iflag: u32,
        c_oflag: u32,
        c_cflag: u32,
        c_lflag: u32,
        c_line: u8,
        c_cc: [u8; 32],
        c_ispeed: u32,
        c_ospeed: u32,
    }

    #[repr(C)]
    pub struct MoldWinsize {
        ws_row: u16,
        ws_col: u16,
        ws_xpixel: u16,
        ws_ypixel: u16,
    }

    #[repr(C)]
    pub struct MoldPollFd {
        fd: i32,
        events: i16,
        revents: i16,
    }

    extern "C" {
        fn tcgetattr(fd: i32, t: *mut MoldTermios) -> i32;
        fn tcsetattr(fd: i32, act: i32, t: *const MoldTermios) -> i32;
        fn ioctl(fd: i32, req: u64, ...) -> i32;
        fn poll(fds: *mut MoldPollFd, n: u64, timeout: i32) -> i32;
        fn read(fd: i32, buf: *mut u8, n: usize) -> isize;
    }

    static MOLD_SAVED: std::sync::Mutex<Option<MoldTermios>> = std::sync::Mutex::new(None);
    static MOLD_PENDING: std::sync::Mutex<Vec<u8>> = std::sync::Mutex::new(Vec::new());
    static MOLD_LAST_SIZE: std::sync::Mutex<(i64, i64)> = std::sync::Mutex::new((0, 0));
    static MOLD_HOOK: std::sync::Once = std::sync::Once::new();

    pub const MOLD_LEAVE_SEQ: &str = "\x1b\x5b?1049l\x1b\x5b?25h\x1b\x5b?1000l\x1b\x5b?1002l\x1b\x5b?1006l\x1b\x5b0m";

    pub fn mold_raw_restore() {
        let saved = match MOLD_SAVED.lock() {
            Ok(mut g) => g.take(),
            Err(p) => p.into_inner().take(),
        };
        if let Some(t) = saved {
            unsafe {
                tcsetattr(0, 2, &t);
            }
        }
    }

    pub fn mold_raw_enable() -> bool {
        unsafe {
            let mut t: MoldTermios = std::mem::zeroed();
            if tcgetattr(0, &mut t) != 0 {
                return false;
            }
            {
                let mut g = match MOLD_SAVED.lock() {
                    Ok(g) => g,
                    Err(p) => p.into_inner(),
                };
                if g.is_none() {
                    *g = Some(t);
                }
            }
            let mut r = t;
            r.c_iflag &= !(0x1 | 0x2 | 0x8 | 0x20 | 0x40 | 0x80 | 0x100 | 0x400);
            r.c_cflag &= !(0x30 | 0x100);
            r.c_cflag |= 0x30;
            r.c_lflag &= !(0x8 | 0x40 | 0x2 | 0x1 | 0x8000);
            r.c_cc[6] = 1;
            r.c_cc[5] = 0;
            let ok = tcsetattr(0, 2, &r) == 0;
            MOLD_HOOK.call_once(|| {
                let prev = std::panic::take_hook();
                std::panic::set_hook(Box::new(move |info| {
                    mold_raw_restore();
                    use std::io::Write;
                    let _ = std::io::stdout().write_all(MOLD_LEAVE_SEQ.as_bytes());
                    let _ = std::io::stdout().flush();
                    prev(info);
                }));
            });
            ok
        }
    }

    pub fn mold_size() -> (i64, i64) {
        unsafe {
            for fd in [1i32, 0i32, 2i32] {
                let mut ws = MoldWinsize { ws_row: 0, ws_col: 0, ws_xpixel: 0, ws_ypixel: 0 };
                if ioctl(fd, 0x5413u64, &mut ws as *mut MoldWinsize) == 0 && ws.ws_col > 0 && ws.ws_row > 0 {
                    return (ws.ws_col as i64, ws.ws_row as i64);
                }
            }
        }
        let cols = std::env::var("COLUMNS").ok().and_then(|v| v.parse::<i64>().ok()).unwrap_or(80);
        let rows = std::env::var("LINES").ok().and_then(|v| v.parse::<i64>().ok()).unwrap_or(24);
        (cols, rows)
    }

